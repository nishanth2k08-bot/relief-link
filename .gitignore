# ReliefLink — Git Ignore Rules

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Environment Variables (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node (if ever added)
node_modules/
dist/
build/

# Netlify
.netlify/

# Temp files
*.tmp
*.bak
